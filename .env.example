# EduEagle Institutional Environment Configuration Template
# Copy this file to .env and configure for your deployment environment.

# Server & Network Settings
EDUEAGLE_PORT=8000
EDUEAGLE_HOST=0.0.0.0
EDUEAGLE_ENV=production
EDUEAGLE_DEMO_MODE=false
EDUEAGLE_SEED_DEMO_DATA=false

# Cryptographic & Security Keys
EDUEAGLE_SECRET_KEY=

# Rate Limiting Controls (Requests per 60-second sliding window)
EDUEAGLE_RATE_LIMIT_AUTH=15
EDUEAGLE_RATE_LIMIT_API=80

# Storage & Database Locations
EDUEAGLE_DB_PATH=edueagle.db
EDUEAGLE_STORAGE_DIR=private_storage
# Optional PostgreSQL URL for Cloud Deployments (e.g. Supabase, Neon)
DATABASE_URL=

# Supabase project credentials (keep service-role key secret)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=student-artifacts

# ─── Firebase Configuration ───────────────────────────────────────────────────
# Firebase Admin SDK (server-side — keep the service account JSON SECRET)
# Option A: Inline JSON credential (paste the whole service account JSON as one line)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: Path to service account JSON file (use one or the other, not both)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Firebase Client SDK (public — safe to commit, embedded in frontend HTML)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Student Success Engine & Well-Being Support
EDUEAGLE_SCHEDULER_TIMEZONE=Asia/Kolkata
EDUEAGLE_TELEMANAS_HELPLINE=14416
EDUEAGLE_BURSAR_AUTO_DISBURSE=false

# Logging & Telemetry
EDUEAGLE_LOG_LEVEL=INFO
